{
  // Terminal > Ejecutar tarea… > "Iniciar tienda": abre base de datos, backend y frontend, cada uno en su terminal.
  "version": "2.0.0",
  "options": {
    "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
  },
  "tasks": [
    {
      "label": "Base de datos",
      "detail": "PostgreSQL 18 local en .pgdata (puerto 5434)",
      "type": "shell",
      "command": ".vscode\\iniciar-bd.cmd",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "dedicated", "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "Backend",
      "detail": "NestJS en http://localhost:4000/api/productos",
      "type": "shell",
      "command": "npm run start:dev",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "dependsOn": "Base de datos",
      "isBackground": true,
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Frontend",
      "detail": "Next.js en http://localhost:3000",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Iniciar tienda",
      "dependsOn": ["Backend", "Frontend"],
      "problemMatcher": []
    }
  ]
}
