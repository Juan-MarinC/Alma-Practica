DATABASE_URL=postgres://tienda:tienda@localhost:5432/tienda
PORT=4000
FRONTEND_URL=http://localhost:3000
# Secreto compartido con el frontend para el panel de administración (mínimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Wompi (Panel de comercios > Desarrolladores). Empieza con las llaves de pruebas (pub_test_, test_integrity_, test_events_).
WOMPI_LLAVE_PUBLICA=
WOMPI_SECRETO_INTEGRIDAD=
WOMPI_SECRETO_EVENTOS=
# Llave privada (prv_test_ / prv_prod_): solo en el servidor. Sirve para confirmar el pago cuando la clienta vuelve de
# Wompi; sin ella el pago se confirma solo por el evento (webhook).
WOMPI_LLAVE_PRIVADA=
# Producción: https://production.wompi.co/v1
WOMPI_API_URL=https://sandbox.wompi.co/v1

# "Continuar con Google" (opcional; sin esto el botón muestra que no está disponible).
# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (aplicación web).
# URI de redirección autorizado: <FRONTEND_URL>/cuenta/google/retorno (en local: http://localhost:3000/cuenta/google/retorno)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correos (opcional; sin esto los correos solo se registran como omitidos). https://resend.com
RESEND_API_KEY=
CORREO_REMITENTE="Alma <pedidos@tu-dominio.co>"
# Correo donde la tienda recibe avisos de pedidos pagados y pagos para revisar
CORREO_TIENDA=
